<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS Redirection & Non-WWW Canonical URL
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://kiyanexports.com/$1 [L,R=301]

  # Fix case-sensitivity for Certificates and catalogues
  RewriteRule ^certificates/(.*)$ Certificates/$1 [L,NC]
  RewriteRule ^catelouges/(.*)$ catalogues/$1 [L,NC]
  RewriteRule ^Catelouges/(.*)$ catalogues/$1 [L,NC]

  # Route Admin & Auth API endpoints to PHP handlers on cPanel
  RewriteRule ^api/admin/users/?$ api-users.php [L,QSA]
  RewriteRule ^api/admin/orders/?$ api-orders.php [L,QSA]
  RewriteRule ^api/auth/register/?$ api-auth.php?action=register [L,QSA]
  RewriteRule ^api/auth/login/?$ api-auth.php?action=login [L,QSA]
  RewriteRule ^api/user/orders/?$ api-orders.php [L,QSA]
</IfModule>

# Force Revalidation for HTML & Dynamic Data (Prevents Old Cached Pages)
<IfModule mod_headers.c>
  # 1. Never cache HTML files, JSON databases, or manifests so browsers always pull fresh site content
  <FilesMatch "\.(html|htm|json|xml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 2. Prevent PDF forced download & set inline preview
  <FilesMatch "\.(pdf)$">
    Header set Content-Disposition inline
    Header set X-Content-Type-Options nosniff
  </FilesMatch>

  # 3. Static Media Assets caching (1 month with revalidation)
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, must-revalidate"
  </FilesMatch>

  # 4. CSS and JavaScript files caching (7 days with revalidation)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>
</IfModule>

# Enable Gzip Compression for Instant Speed Optimization
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>
